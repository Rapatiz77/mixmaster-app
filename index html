<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>MixMaster – Mixage et mastering en ligne</title>
<style>
  :root {
    --bg: #eef1f2;
    --panel: #ffffff;
    --ink: #12343b;
    --muted: #5d747a;
    --accent: #1f7a8c;
    --signal: #f2a541;
    --line: #cfd9dc;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f2226;
      --panel: #16313a;
      --ink: #e6eff1;
      --muted: #94b0b6;
      --accent: #4fb3c7;
      --signal: #f2a541;
      --line: #2a4a53;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: "Avenir Next", "Segoe UI", system-ui, -apple-system, sans-serif;
    line-height: 1.5;
    padding: max(16px, env(safe-area-inset-top)) 16px max(24px, env(safe-area-inset-bottom));
  }
  main { max-width: 560px; margin: 0 auto; }
  h1 { font-size: 1.7rem; margin: 8px 0 4px; letter-spacing: -0.02em; }
  .sub { color: var(--muted); margin: 0 0 20px; }
  .panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px;
    margin-bottom: 14px;
  }
  h2 { font-size: 1rem; margin: 0 0 12px; }
  input[type="file"] { width: 100%; font-size: 1rem; }
  #fileInfo { color: var(--muted); font-size: .9rem; margin: 8px 0 0; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; }
  button {
    font: inherit;
    font-weight: 600;
    border: 0;
    border-radius: 10px;
    padding: 12px 16px;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    flex: 1 1 auto;
  }
  button.alt { background: transparent; color: var(--ink); border: 1px solid var(--line); }
  button.on { background: var(--signal); color: #12343b; border-color: var(--signal); }
  button:disabled { opacity: .45; cursor: not-allowed; }
  button:focus-visible, input:focus-visible { outline: 3px solid var(--signal); outline-offset: 2px; }
  .ctl { margin-bottom: 14px; }
  .ctl:last-child { margin-bottom: 0; }
  .ctl label { display: flex; justify-content: space-between; font-size: .95rem; margin-bottom: 4px; }
  .ctl output { color: var(--muted); font-variant-numeric: tabular-nums; }
  input[type="range"] { width: 100%; accent-color: var(--accent); }
  #status { min-height: 1.4em; color: var(--muted); font-size: .9rem; margin: 6px 0 0; }
</style>
</head>
<body>
<main>
  <h1>MixMaster</h1>
  <p class="sub">Charge ton morceau, règle le son, exporte en WAV.</p>

  <section class="panel">
    <h2>1. Ton fichier audio</h2>
    <input type="file" id="file" accept="audio/*">
    <p id="fileInfo">Aucun fichier chargé.</p>
  </section>

  <section class="panel">
    <h2>2. Préréglages</h2>
    <div class="row">
      <button class="alt" data-preset="doux">Doux</button>
      <button class="alt" data-preset="rap">Rap</button>
      <button class="alt" data-preset="club">Club</button>
    </div>
  </section>

  <section class="panel">
    <h2>3. Réglages</h2>
    <div class="ctl"><label for="low">Graves <output id="lowO"></output></label>
      <input type="range" id="low" min="-12" max="12" step="0.5" value="0"></div>
    <div class="ctl"><label for="mid">Médiums <output id="midO"></output></label>
      <input type="range" id="mid" min="-12" max="12" step="0.5" value="0"></div>
    <div class="ctl"><label for="high">Aigus <output id="highO"></output></label>
      <input type="range" id="high" min="-12" max="12" step="0.5" value="0"></div>
    <div class="ctl"><label for="thr">Seuil de compression <output id="thrO"></output></label>
      <input type="range" id="thr" min="-50" max="0" step="1" value="-18"></div>
    <div class="ctl"><label for="ratio">Taux de compression <output id="ratioO"></output></label>
      <input type="range" id="ratio" min="1" max="20" step="0.5" value="3"></div>
    <div class="ctl"><label for="gain">Volume de sortie <output id="gainO"></output></label>
      <input type="range" id="gain" min="-12" max="12" step="0.5" value="0"></div>
    <div class="ctl"><label for="ceil">Plafond du limiteur <output id="ceilO"></output></label>
      <input type="range" id="ceil" min="-6" max="0" step="0.1" value="-1"></div>
  </section>

  <section class="panel">
    <h2>4. Écoute et export</h2>
    <div class="row">
      <button id="play" disabled>Lire</button>
      <button id="stop" class="alt" disabled>Arrêter</button>
      <button id="ab" class="alt" disabled>Original</button>
    </div>
    <div class="row" style="margin-top:10px">
      <button id="export" disabled>Exporter en WAV</button>
    </div>
    <p id="status" role="status"></p>
  </section>
</main>

<script>
(function () {
  var AC = window.AudioContext || window.webkitAudioContext;
  var ctx = null;
  var buffer = null;
  var fileName = "morceau";
  var source = null;
  var live = null;
  var bypass = false;

  var $ = function (id) { return document.getElementById(id); };
  var ids = ["low", "mid", "high", "thr", "ratio", "gain", "ceil"];
  var units = { low: " dB", mid: " dB", high: " dB", thr: " dB", ratio: " : 1", gain: " dB", ceil: " dB" };

  function params() {
    var p = {};
    ids.forEach(function (k) { p[k] = parseFloat($(k).value); });
    return p;
  }

  function refreshLabels() {
    ids.forEach(function (k) { $(k + "O").textContent = $(k).value + units[k]; });
  }

  function setStatus(t) { $("status").textContent = t; }

  // Construit la chaîne de traitement : EQ -> compresseur -> volume -> limiteur
  function buildChain(c) {
    var low = c.createBiquadFilter();
    low.type = "lowshelf"; low.frequency.value = 120;
    var mid = c.createBiquadFilter();
    mid.type = "peaking"; mid.frequency.value = 1500; mid.Q.value = 0.8;
    var high = c.createBiquadFilter();
    high.type = "highshelf"; high.frequency.value = 6000;
    var comp = c.createDynamicsCompressor();
    comp.knee.value = 6; comp.attack.value = 0.01; comp.release.value = 0.2;
    var gain = c.createGain();
    var lim = c.createDynamicsCompressor();
    lim.ratio.value = 20; lim.knee.value = 0;
    lim.attack.value = 0.001; lim.release.value = 0.08;
    low.connect(mid); mid.connect(high); high.connect(comp);
    comp.connect(gain); gain.connect(lim);
    return { input: low, output: lim, low: low, mid: mid, high: high, comp: comp, gain: gain, lim: lim };
  }

  function applyParams(n, p) {
    n.low.gain.value = p.low;
    n.mid.gain.value = p.mid;
    n.high.gain.value = p.high;
    n.comp.threshold.value = p.thr;
    n.comp.ratio.value = p.ratio;
    n.gain.gain.value = Math.pow(10, p.gain / 20);
    n.lim.threshold.value = p.ceil;
  }

  function onChange() {
    refreshLabels();
    if (live) applyParams(live.chain, params());
  }
  ids.forEach(function (k) { $(k).addEventListener("input", onChange); });

  var presets = {
    doux: { low: 1, mid: 0, high: 1.5, thr: -20, ratio: 2, gain: 0, ceil: -1 },
    rap:  { low: 4, mid: -1, high: 2.5, thr: -22, ratio: 4, gain: 1.5, ceil: -1 },
    club: { low: 5, mid: -2, high: 3, thr: -26, ratio: 6, gain: 2.5, ceil: -0.5 }
  };
  document.querySelectorAll("[data-preset]").forEach(function (b) {
    b.addEventListener("click", function () {
      var p = presets[b.getAttribute("data-preset")];
      ids.forEach(function (k) { $(k).value = p[k]; });
      onChange();
      setStatus("Préréglage appliqué.");
    });
  });

  function enable(on) {
    ["play", "stop", "ab", "export"].forEach(function (id) { $(id).disabled = !on; });
  }

  $("file").addEventListener("change", function (e) {
    var f = e.target.files[0];
    if (!f) return;
    stop();
    enable(false);
    setStatus("Chargement…");
    fileName = f.name.replace(/\.[^.]+$/, "") || "morceau";
    var reader = new FileReader();
    reader.onload = function () {
      if (!ctx) ctx = new AC();
      ctx.decodeAudioData(reader.result, function (b) {
        buffer = b;
        $("fileInfo").textContent = f.name + " – " + b.duration.toFixed(1) + " s, " +
          b.numberOfChannels + " canal(aux), " + b.sampleRate + " Hz";
        enable(true);
        setStatus("Prêt. Appuie sur Lire.");
      }, function () {
        setStatus("Ce fichier ne peut pas être lu. Essaie un MP3, WAV ou M4A.");
      });
    };
    reader.onerror = function () { setStatus("Impossible de lire le fichier."); };
    reader.readAsArrayBuffer(f);
  });

  function play() {
    if (!buffer) return;
    stop();
    if (ctx.state === "suspended") ctx.resume();
    var chain = buildChain(ctx);
    applyParams(chain, params());
    var wet = ctx.createGain();
    var dry = ctx.createGain();
    wet.gain.value = bypass ? 0 : 1;
    dry.gain.value = bypass ? 1 : 0;
    source = ctx.createBufferSource();
    source.buffer = buffer;
    source.loop = true;
    source.connect(chain.input);
    chain.output.connect(wet); wet.connect(ctx.destination);
    source.connect(dry); dry.connect(ctx.destination);
    source.start();
    live = { chain: chain, wet: wet, dry: dry };
    setStatus(bypass ? "Lecture : original." : "Lecture : son traité.");
  }

  function stop() {
    if (source) { try { source.stop(); } catch (e) {} source.disconnect(); source = null; }
    live = null;
  }

  $("play").addEventListener("click", play);
  $("stop").addEventListener("click", function () { stop(); setStatus("Arrêté."); });
  $("ab").addEventListener("click", function () {
    bypass = !bypass;
    $("ab").classList.toggle("on", bypass);
    $("ab").textContent = bypass ? "Original (actif)" : "Original";
    if (live) {
      live.wet.gain.value = bypass ? 0 : 1;
      live.dry.gain.value = bypass ? 1 : 0;
      setStatus(bypass ? "Lecture : original." : "Lecture : son traité.");
    }
  });

  function toWav(b) {
    var ch = b.numberOfChannels, len = b.length, sr = b.sampleRate;
    var bytes = 44 + len * ch * 2;
    var view = new DataView(new ArrayBuffer(bytes));
    function str(o, s) { for (var i = 0; i < s.length; i++) view.setUint8(o + i, s.charCodeAt(i)); }
    str(0, "RIFF"); view.setUint32(4, bytes - 8, true); str(8, "WAVE");
    str(12, "fmt "); view.setUint32(16, 16, true); view.setUint16(20, 1, true);
    view.setUint16(22, ch, true); view.setUint32(24, sr, true);
    view.setUint32(28, sr * ch * 2, true); view.setUint16(32, ch * 2, true);
    view.setUint16(34, 16, true); str(36, "data"); view.setUint32(40, len * ch * 2, true);
    var data = [];
    for (var c = 0; c < ch; c++) data.push(b.getChannelData(c));
    var o = 44;
    for (var i = 0; i < len; i++) {
      for (var c2 = 0; c2 < ch; c2++) {
        var s = Math.max(-1, Math.min(1, data[c2][i]));
        view.setInt16(o, s < 0 ? s * 0x8000 : s * 0x7fff, true);
        o += 2;
      }
    }
    return new Blob([view], { type: "audio/wav" });
  }

  $("export").addEventListener("click", function () {
    if (!buffer) return;
    enable(false);
    setStatus("Traitement en cours…");
    var OAC = window.OfflineAudioContext || window.webkitOfflineAudioContext;
    var off = new OAC(buffer.numberOfChannels, buffer.length, buffer.sampleRate);
    var chain = buildChain(off);
    applyParams(chain, params());
    var src = off.createBufferSource();
    src.buffer = buffer;
    src.connect(chain.input);
    chain.output.connect(off.destination);
    src.start();
    off.startRendering().then(function (rendered) {
      var blob = toWav(rendered);
      var url = URL.createObjectURL(blob);
      var a = document.createElement("a");
      a.href = url;
      a.download = fileName + "-master.wav";
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(function () { URL.revokeObjectURL(url); }, 10000);
      enable(true);
      setStatus("Export terminé : " + a.download);
    }).catch(function () {
      enable(true);
      setStatus("L'export a échoué. Réessaie avec un fichier plus court.");
    });
  });

  refreshLabels();
})();
</script>
</body>
</html>
